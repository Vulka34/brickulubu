{
  "name": "brickulubu",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "sekans.brickulubu.com", "custom_domain": true },
    { "pattern": "kup.brickulubu.com", "custom_domain": true }
  ]
}